<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Finstat.Desktop.Controls"
    x:Class="Finstat.Desktop.Controls.FieldError"
    x:Name="Root"
    x:DataType="controls:FieldError"
    IsVisible="{Binding Text, Source={x:Reference Root}, Converter={StaticResource HasText}}">

    <HorizontalStackLayout Spacing="4" Margin="0,8,0,0">
        <Image Source="icon_alert.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
        <Label Text="{Binding Text, Source={x:Reference Root}}" Style="{StaticResource ErrorText}" Margin="0" VerticalOptions="Center" />
    </HorizontalStackLayout>

</ContentView>
