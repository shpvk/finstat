<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Finstat.Desktop.Controls.LoadingView"
    SemanticProperties.Description="Завантаження…">

    <Border Style="{StaticResource Panel}">
        <Grid RowDefinitions="14,14,14" RowSpacing="16" ColumnDefinitions="46*,16*,22*,16*">
            <BoxView x:Name="First" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="6" Color="{StaticResource ColorSurfaceHover}" />
            <BoxView x:Name="Second" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="6" Color="{StaticResource ColorSurfaceHover}" />
            <BoxView x:Name="Third" Grid.Row="2" Grid.Column="0" CornerRadius="6" Color="{StaticResource ColorSurfaceHover}" />
        </Grid>
    </Border>

</ContentView>
