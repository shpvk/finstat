<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Finstat.Desktop.Controls"
    x:Class="Finstat.Desktop.Controls.StateView"
    x:Name="Root"
    x:DataType="controls:StateView">

    <Border Style="{StaticResource Panel}" Padding="24,48">
        <VerticalStackLayout HorizontalOptions="Center" Spacing="0" MaximumWidthRequest="448">
            <Image
                Source="{Binding Icon, Source={x:Reference Root}}"
                WidthRequest="24"
                HeightRequest="24"
                HorizontalOptions="Center" />
            <Label
                Text="{Binding Title, Source={x:Reference Root}}"
                FontFamily="InterSemiBold"
                HorizontalTextAlignment="Center"
                Margin="0,16,0,0" />
            <Label
                Text="{Binding Description, Source={x:Reference Root}}"
                Style="{StaticResource Muted}"
                HorizontalTextAlignment="Center"
                Margin="0,4,0,0"
                IsVisible="{Binding Description, Source={x:Reference Root}, Converter={StaticResource HasText}}" />
            <Button
                x:Name="ActionButton"
                Text="{Binding ActionText, Source={x:Reference Root}}"
                Command="{Binding ActionCommand, Source={x:Reference Root}}"
                CommandParameter="{Binding ActionParameter, Source={x:Reference Root}}"
                HorizontalOptions="Center"
                Margin="0,24,0,0"
                IsVisible="{Binding ActionText, Source={x:Reference Root}, Converter={StaticResource HasText}}" />
        </VerticalStackLayout>
    </Border>

</ContentView>
