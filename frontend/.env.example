# Скопируйте в .env, если значения по умолчанию не подходят.

# Базовый адрес API для браузера, без завершающего слэша.
# По умолчанию /api — тот же origin (dev-прокси Vite, в Docker — веб-сервер).
# VITE_API_BASE_URL=/api

# Куда dev-сервер Vite проксирует запросы /api (адрес запущенного бэкенда).
# API_PROXY_TARGET=http://localhost:8080
